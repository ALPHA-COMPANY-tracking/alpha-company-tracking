# Copie este arquivo para .env.local e preencha com as chaves do seu
# projeto Supabase (Project Settings → API). O .env.local NÃO vai pro git.
#
# Sem estas chaves, o app roda no MODO LOCAL (dados no navegador).
# Com as chaves, o app entra no MODO NUVEM (login + dados salvos online).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
